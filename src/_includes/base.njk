<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}" />{% endif %}
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}" />
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,400&family=Spectral:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="{{ site.name }}">
        <svg class="mark" viewBox="0 0 48 48" role="img" aria-hidden="true" focusable="false">
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2.5" />
          <path d="M24 7 a17 17 0 1 1 0 34 a11.5 11.5 0 1 0 0 -34 Z" fill="currentColor" />
          <circle cx="24" cy="24" r="3.1" fill="var(--paper)" />
        </svg>
        <span class="wordmark">{{ site.name }}</span>
      </a>
      <p class="tagline">{{ site.tagline }}</p>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.footer }}</p>
      <p class="foot-links"><a href="/">Archivio</a> · <a href="/feed.xml">RSS</a></p>
    </footer>
  </body>
</html>
