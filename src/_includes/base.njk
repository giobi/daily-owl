<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}" />{% endif %}
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}" />
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,400&family=Spectral:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/"><span class="owl">&#129417;</span> {{ site.name }}</a>
      <p class="tagline">{{ site.tagline }}</p>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.footer }}</p>
      <p class="foot-links"><a href="/">Archivio</a> · <a href="/feed.xml">RSS</a></p>
    </footer>
  </body>
</html>
