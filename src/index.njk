---
layout: base.njk
title: false
---
<ul class="post-list">
  {% for post in collections.published %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="date">{{ post.date | dataIt }}</span>
  </li>
  {% else %}
  <li class="empty">Ancora niente di pubblicato. Il gufo scrive di notte.</li>
  {% endfor %}
</ul>
