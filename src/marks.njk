<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Owl - marchi candidati</title>
<style>
  :root{--ink:#1b1714;--paper:#f7f3ec;--accent:#9a3b1f;--soft:#6f655c;}
  body{margin:0;background:var(--paper);color:var(--ink);
       font-family:Georgia,serif;padding:2.5rem 1.2rem 4rem;}
  h1{text-align:center;font-weight:900;letter-spacing:-.01em;}
  p.sub{text-align:center;color:var(--soft);margin:0 0 2.5rem;}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
        gap:1.6rem;max-width:760px;margin:0 auto;}
  .cell{background:#fffdf9;border:1px solid #e6ded2;border-radius:6px;
        padding:1.4rem 1rem;text-align:center;}
  .cell .mk{width:60px;height:60px;color:var(--ink);display:block;margin:0 auto .7rem;}
  .num{font-weight:900;font-size:1.1rem;}
  .lbl{color:var(--soft);font-size:.82rem;display:block;margin-top:.2rem;}
  .lockup{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:1rem;}
  .lockup .mk{width:34px;height:34px;margin:0;}
  .lockup span{font-weight:900;font-size:1.25rem;letter-spacing:-.01em;}
  .hr{max-width:760px;margin:3rem auto 1rem;border:0;border-top:1px solid #e6ded2;}
</style>
</head>
<body>
<h1>Sei marchi, scegline uno</h1>
<p class="sub">Astratti, monocromi. Dimmi il numero e lo monto nell'header.</p>

<div class="grid">

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <mask id="c1"><rect width="48" height="48" fill="#fff"/><circle cx="32" cy="20" r="18" fill="#000"/></mask>
      <circle cx="24" cy="24" r="20" fill="currentColor" mask="url(#c1)"/>
    </svg>
    <span class="num">1</span><span class="lbl">falce / luna</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><mask id="c1b"><rect width="48" height="48" fill="#fff"/><circle cx="32" cy="20" r="18" fill="#000"/></mask><circle cx="24" cy="24" r="20" fill="currentColor" mask="url(#c1b)"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="2.5"/>
      <path d="M24 5 A19 19 0 0 0 24 43 Z" fill="currentColor"/>
    </svg>
    <span class="num">2</span><span class="lbl">mezzo pieno</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M24 5 A19 19 0 0 0 24 43 Z" fill="currentColor"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <circle cx="17" cy="24" r="12.5" fill="none" stroke="currentColor" stroke-width="3"/>
      <circle cx="31" cy="24" r="12.5" fill="none" stroke="currentColor" stroke-width="3"/>
    </svg>
    <span class="num">3</span><span class="lbl">due cerchi</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><circle cx="17" cy="24" r="12.5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="31" cy="24" r="12.5" fill="none" stroke="currentColor" stroke-width="3"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="78 30" transform="rotate(35 24 24)"/>
    </svg>
    <span class="num">4</span><span class="lbl">anello aperto</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="78 30" transform="rotate(35 24 24)"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <g transform="rotate(45 24 24)"><rect x="8" y="8" width="32" height="32" rx="7" fill="currentColor"/></g>
      <circle cx="24" cy="24" r="6.5" fill="var(--paper)"/>
    </svg>
    <span class="num">5</span><span class="lbl">rombo forato</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><g transform="rotate(45 24 24)"><rect x="8" y="8" width="32" height="32" rx="7" fill="currentColor"/></g><circle cx="24" cy="24" r="6.5" fill="#f7f3ec"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

  <div class="cell">
    <svg class="mk" viewBox="0 0 48 48">
      <path d="M10 17 L24 27 L38 17" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 29 L24 39 L38 29" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="num">6</span><span class="lbl">doppio cuneo</span>
    <div class="lockup">
      <svg class="mk" viewBox="0 0 48 48"><path d="M10 17 L24 27 L38 17" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 29 L24 39 L38 29" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Daily Owl</span>
    </div>
  </div>

</div>
<hr class="hr">
<p class="sub">Ognuno è mostrato grande e in versione header. Nessuno deve sembrare un gufo.</p>
</body>
</html>
